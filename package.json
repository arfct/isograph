{
	"name": "isograph",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "A 3D viewer and editor for simple primitive isometric diagrams",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "npm run build && wrangler dev",
		"deploy": "npm run build && wrangler deploy",
		"prepare": "svelte-kit sync || echo ''",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"biome": "biome check",
		"typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"cf-typegen": "wrangler types"
	},
	"dependencies": {
		"heroicons": "^2.2.0",
		"three": "^0.186.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@eslint/js": "^10.0.1",
		"@sveltejs/adapter-cloudflare": "^7.2.9",
		"@sveltejs/kit": "^2.70.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^24.19.2",
		"@types/three": "^0.186.0",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.1",
		"svelte-check": "^4.7.6",
		"tailwindcss": "^4.3.3",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.0",
		"vitest": "^4.1.11",
		"wrangler": "^4.152.0"
	},
	"allowScripts": {
		"esbuild@0.28.2": true,
		"workerd@1.20261019.1": true
	}
}
